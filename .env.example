# CascadeGuard AI — Environment Variables
# Copy this file to .env and fill in your actual values.
# NEVER commit .env to git.

# ── Razorpay ──────────────────────────────────────────────────────────────────
RAZORPAY_KEY_ID=rzp_test_REPLACE_ME
RAZORPAY_KEY_SECRET=REPLACE_ME
RAZORPAY_WEBHOOK_SECRET=REPLACE_ME

# ── Supabase / Postgres ───────────────────────────────────────────────────────
SUPABASE_URL=REPLACE_ME
SUPABASE_ANON_KEY=REPLACE_ME
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_SERVICE_ROLE_KEY_FROM_DASHBOARD
# Direct Postgres connection string (Settings → Database → Connection string)
DATABASE_URL=postgresql+asyncpg://postgres:REPLACE_PASSWORD@REPLACE_ME

# ── Groq ──────────────────────────────────────────────────────────────────────
GROQ_API_KEY=REPLACE_ME
GROQ_PRIMARY_MODEL=openai/gpt-oss-120b
GROQ_FALLBACK_MODEL=openai/gpt-oss-20b

# ── Resend (email fallback) ───────────────────────────────────────────────────
RESEND_API_KEY=REPLACE_ME
RESEND_FROM_EMAIL=no-reply@REPLACE_ME.com

# ── App ───────────────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET_KEY=REPLACE_WITH_RANDOM_32_BYTES
LOG_LEVEL=INFO
SENTRY_DSN=
